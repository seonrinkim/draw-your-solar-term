NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Apps Script web app that mirrors each submission's PNG into a
# Drive folder and appends a row (term, nickname, note, image link) to a
# Google Sheet. See supabase/schema.sql's sibling, google-apps-script/Code.gs.
NEXT_PUBLIC_MIRROR_URL=https://script.google.com/macros/s/your-deployment-id/exec
NEXT_PUBLIC_MIRROR_SECRET=your-shared-secret
